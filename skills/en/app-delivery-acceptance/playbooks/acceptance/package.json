    "@sublang/cligent": "file:vendor/sublang-cligent-0.36.2-acceptance.20261031.1.tgz",
    "@sublang/playbook": "file:vendor/sublang-playbook-18.1.1-acceptance.20261031.1.tgz",
    "@sublang/spex": "4.0.0",
    "picomatch": "4.0.7",
    "smol-toml": "1.9.1",
    "xstate": "5.33.2"
