/* -- Narrowing helpers ----------------------------------------------------- */

function asRecord(value: unknown): Record<string, unknown> | undefined {
  return typeof value === 'object' && value !== null && !Array.isArray(value)
    ? (value as Record<string, unknown>)
    : undefined;
}

function readString(source: Record<string, unknown> | undefined, field: string): string | undefined {
  if (source === undefined) return undefined;
  const value = source[field];
  return typeof value === 'string' ? value : undefined;
}

/** Structurally narrows an actor-completion event to its declared output record. */
function actorOutput(event: unknown): Record<string, unknown> | undefined {
  const record = asRecord(event);
  return record === undefined ? undefined : asRecord(record.output);
}

function matchesOutput(event: unknown, guard: string, required?: readonly string[]): boolean {
  const output = actorOutput(event);
  if (output === undefined || output.guard !== guard) return false;
  if (required === undefined) return true;
  return required.every((field) => {
    const value = output[field];
    return typeof value === 'string' && value.trim() !== '';
  });
}

function outputIs(guard: string, required?: readonly string[]) {
  return ({ event }: { context: MachineContext; event: unknown }): boolean =>
    matchesOutput(event, guard, required);
}

function normalizeError(error: unknown): NormalizedError {
  if (error instanceof Error) {
    return error.stack === undefined
      ? { name: error.name, message: error.message }
      : { name: error.name, message: error.message, stack: error.stack };
  }
  return { name: 'Error', message: typeof error === 'string' ? error : 'Unknown error' };
}

type NarrowArgs = { context: MachineContext; event: unknown };

/* -- Per-state outcome guards (each guards only its own state's contract) --- */

const scenario2GapsRepairable = ({ context, event }: NarrowArgs): boolean =>
  matchesOutput(event, 'gaps', ['scenarioFindings']) && context.scenarioReviewRounds < 3;
const scenario2GapsExhausted = ({ context, event }: NarrowArgs): boolean =>
  matchesOutput(event, 'gaps', ['scenarioFindings']) && context.scenarioReviewRounds >= 3;
const scenario4FailedRepairable = ({ context, event }: NarrowArgs): boolean =>
  matchesOutput(event, 'failed') && context.scenarioReviewRounds < 3;
const scenario4FailedExhausted = ({ context, event }: NarrowArgs): boolean =>
  matchesOutput(event, 'failed') && context.scenarioReviewRounds >= 3;
const execution2RepairableAgain = ({ context, event }: NarrowArgs): boolean =>
  matchesOutput(event, 'repairable', ['reviewFindings']) && context.executionReviewRounds < 3;
const execution2RepairableExhausted = ({ context, event }: NarrowArgs): boolean =>
  matchesOutput(event, 'repairable', ['reviewFindings']) && context.executionReviewRounds >= 3;
const execution3FailedRepairable = ({ context, event }: NarrowArgs): boolean =>
  matchesOutput(event, 'failed') && context.executionReviewRounds < 3;
const execution3FailedExhausted = ({ context, event }: NarrowArgs): boolean =>
  matchesOutput(event, 'failed') && context.executionReviewRounds >= 3;
const completionAccepted = ({ event }: NarrowArgs): boolean => {
  const output = actorOutput(event);
  return (
    output !== undefined &&
    output.guard === 'accepted' &&
    typeof output.response === 'string' &&
    output.response.trim() !== ''
  );
};
const completionIncomplete = ({ event }: NarrowArgs): boolean => {
  const output = actorOutput(event);
  return (
    output !== undefined &&
    output.guard === 'incomplete' &&
    typeof output.response === 'string' &&
    output.response.trim() !== '' &&
    typeof output.failureDetails === 'string' &&
    output.failureDetails.trim() !== ''
  );
};
const actorNeedsBossReply = ({ event }: NarrowArgs): boolean => {
  const output = actorOutput(event);
  return (
    output !== undefined &&
    output.guard === 'needsBossReply' &&
    typeof output.question === 'string' &&
    output.question.trim() !== ''
  );
};

/* -- Transition-array helpers ---------------------------------------------- */

/** The root-machine accepted-outcome marker the linked runtime observes. */
function acceptedOutcomeAction(source: string, target: string, acceptedOutcome: string) {
  return {
    type: 'playbook.acceptedOutcome' as const,
    params: { source, target, acceptedOutcome },
  };
}

/**
 * Builds one `BOSS_REPLY` arm per resumable working leaf. With a single pending
 * question an omitted `questionId` is accepted and filled with the sole id; an
 * empty answer never resumes.
 */
function resumableStates(ids: readonly string[]) {
  return ids.map((id) => ({
    guard: ({ context, event }: NarrowArgs): boolean => {
      const reply = asRecord(event);
      if (reply === undefined || reply.type !== 'BOSS_REPLY') return false;
      const questionId = readString(reply, 'questionId');
      if (questionId !== undefined && questionId !== id) return false;
      const pending = context.pendingBossQuestion;
      if (pending === undefined || pending.resumeStateId !== id) return false;
      const answer = readString(reply, 'answer');
      return answer !== undefined && answer.trim() !== '';
    },
    target: `#${id}`,
    reenter: true,
    actions: ['recordBossReply'] as const,
  }));
}

/**
 * Context a jumpable state must already hold. An interrupt never jumps into a
 * working state whose declared inputs cannot be populated.
 */
const INTERRUPT_CONTEXT_REQUIREMENTS: Readonly<
  Record<string, (context: MachineContext) => boolean>
> = {
  scenario3: (context) => context.scenarioFindings !== undefined,
  execution2: (context) => context.runId !== undefined,
  execution3: (context) => context.runId !== undefined,
  execution4: (context) =>
    context.runId !== undefined && context.reviewFindings !== undefined,
  execution5: (context) => context.runId !== undefined,
};

/** Builds the root `BOSS_INTERRUPT` arms for the jumpable states. */
function bossInterrupts(ids: readonly string[]) {
  return ids.map((id) => ({
    guard: ({ context, event }: NarrowArgs): boolean => {
      const interrupt = asRecord(event);
      if (interrupt === undefined || interrupt.type !== 'BOSS_INTERRUPT') return false;
      if (interrupt.targetId !== id) return false;
      const required = INTERRUPT_CONTEXT_REQUIREMENTS[id];
      return required === undefined || required(context);
    },
    target: `#${id}`,
    reenter: true,
    actions: ['clearBossReplyContext'] as const,
  }));
}

/**
 * Records the pending Boss question for one suspended working leaf. The
 * question id, resume state id, and source item come from that leaf's stable
 * invocation metadata, so a resumed reply is delivered back to the leaf that
 * asked.
 */
function setPendingBossQuestion(
  event: unknown,
  leaf: {
    readonly stateId: string;
    readonly sourceItem: string;
    readonly role?: string;
  },
): Partial<MachineContext> {
  const question = readString(actorOutput(event), 'question');
  if (question === undefined) return {};
  return {
    pendingBossQuestion: {
      questionId: leaf.stateId,
      resumeStateId: leaf.stateId,
      sourceItem: leaf.sourceItem,
      asker: leaf.role === undefined ? { kind: 'captain' } : { kind: 'role', roleId: leaf.role },
      question,
    },
  };
}

