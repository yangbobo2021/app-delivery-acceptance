/* -- Machine --------------------------------------------------------------- */

export const deliveryAcceptanceMachine = setup({
  types: {
    context: {} as MachineContext,
    events: {} as MachineEvent,
    input: {} as DeliveryAcceptanceMachineInput,
    output: {} as DeliveryAcceptanceMachineOutput,
  },
  actors: {
    captain: fromPromise<CaptainOutput, CaptainInput>(async () => {
      throw new Error('captain actor must be provided by the runner');
    }),
    player: fromPromise<PlayerOutput, PlayerInput>(async () => {
      throw new Error('player actor must be provided by the runner');
    }),
  },
  actions: {
    'playbook.acceptedOutcome': (
      _args: unknown,
      _params: { source: string; target: string; acceptedOutcome: string },
    ): void => {
      // Root-machine marker consumed by the linked runtime; inert inside the FSM.
    },
    // XState merges an assign result into context, so clearing an optional
    // member means assigning it `undefined`; the JSON-safe records this
    // artifact emits (actor inputs, machine output, persisted snapshots) omit
    // the absent member instead of carrying a null placeholder.
    clearBossReplyContext: assign({
      pendingBossQuestion: () => undefined,
      bossReply: () => undefined,
    }),
    recordBossReply: assign(({ event }: NarrowArgs): Partial<MachineContext> => {
      const answer = readString(asRecord(event), 'answer');
      return answer === undefined ? {} : { bossReply: answer };
    }),
    rememberError: assign({
      lastError: ({ event }: NarrowArgs): NormalizedError =>
        normalizeError(asRecord(event)?.error),
    }),
    rememberMalformedBossReply: assign({
      lastError: (): NormalizedError => ({
        name: 'MalformedBossReplyError',
        message: 'BOSS_REPLY matched no pending question or carried an empty answer.',
      }),
    }),
    seedBossIntent: assign(({ event }: NarrowArgs): Partial<MachineContext> => {
      const intent = readString(asRecord(event), 'bossIntent');
      return intent === undefined ? {} : { bossIntent: intent };
    }),
    restartWorkflow: assign({
      bossIntent: () => undefined,
      runId: () => undefined,
      scenarioFindings: () => undefined,
      reviewFindings: () => undefined,
      pendingBossQuestion: () => undefined,
      bossReply: () => undefined,
      outcome: () => undefined,
      lastError: () => undefined,
      response: () => '',
      failureDetails: () => '',
      scenarioReviewRounds: () => 0,
      executionReviewRounds: () => 0,
    }),
    storeScenarioFindings: assign(({ event }: NarrowArgs): Partial<MachineContext> => {
      const findings = readString(actorOutput(event), 'scenarioFindings');
      return findings === undefined ? {} : { scenarioFindings: findings };
    }),
    storeReviewFindings: assign(({ event }: NarrowArgs): Partial<MachineContext> => {
      const findings = readString(actorOutput(event), 'reviewFindings');
      return findings === undefined ? {} : { reviewFindings: findings };
    }),
    storeRunId: assign(({ event }: NarrowArgs): Partial<MachineContext> => {
      const runId = readString(actorOutput(event), 'runId');
      return runId === undefined ? {} : { runId };
    }),
    recordAccepted: assign(({ event }: NarrowArgs): Partial<MachineContext> => ({
      outcome: 'accepted',
      response: readString(actorOutput(event), 'response') ?? '',
    })),
    recordIncomplete: assign(({ event }: NarrowArgs): Partial<MachineContext> => {
      const output = actorOutput(event);
      const next: Partial<MachineContext> = {
        outcome: 'incomplete',
        response: readString(output, 'response') ?? '',
        failureDetails: readString(output, 'failureDetails') ?? '',
      };
      const runId = readString(output, 'runId');
      if (runId !== undefined) next.runId = runId;
      return next;
    }),
    setPendingBossQuestionEntry1: assign(({ event }) =>
      setPendingBossQuestion(event, { stateId: 'entry1', sourceItem: 'ENTRY-1', role: 'analyst' }),
    ),
    setPendingBossQuestionResource1: assign(({ event }) =>
      setPendingBossQuestion(event, {
        stateId: 'resource1',
        sourceItem: 'RESOURCE-1',
        role: 'analyst',
      }),
    ),
    setPendingBossQuestionScenario1: assign(({ event }) =>
      setPendingBossQuestion(event, {
        stateId: 'scenario1',
        sourceItem: 'SCENARIO-1',
        role: 'analyst',
      }),
    ),
    setPendingBossQuestionScenario2: assign(({ event }) =>
      setPendingBossQuestion(event, {
        stateId: 'scenario2',
        sourceItem: 'SCENARIO-2',
        role: 'reviewer',
      }),
    ),
    setPendingBossQuestionScenario3: assign(({ event }) =>
      setPendingBossQuestion(event, {
        stateId: 'scenario3',
        sourceItem: 'SCENARIO-3',
        role: 'analyst',
      }),
