import { assign, fromPromise, setup } from 'xstate';

/**
 * XState v5 finite-state machine for the "App delivery acceptance" playbook.
 *
 * This artifact defines the machine, its actor contracts, and its typed inputs
 * only. It binds no runner and supplies no concrete actor implementation: every
 * actor placeholder fails explicitly until the linked runtime provides it.
 */

export type BossQuestionAsker =
  | { readonly kind: 'captain' }
  | { readonly kind: 'role'; readonly roleId: string };

/** The pending Boss question a suspended working leaf recorded. */
export interface PendingBossQuestion {
  readonly questionId: string;
  readonly resumeStateId: string;
  readonly sourceItem: string;
  readonly asker: BossQuestionAsker;
  readonly question: string;
}

/** JSON-safe control error captured for inspection. */
export interface NormalizedError {
  name: string;
  message: string;
  stack?: string;
}

/** Machine construction input: the workflow's host-owned bootstrap values. */
export interface DeliveryAcceptanceMachineInput {
  /** The target application project the acceptance run evaluates. */
  readonly project: string;
  /** The confirmed requirements JSON file for that project. */
  readonly requirementsFile: string;
  /** The installed path of the app-delivery-acceptance skill. */
  readonly skill: string;
}

/** Direct-Captain actor contract. */
export interface CaptainInput {
  readonly stateId: string;
  readonly sourceItem: string;
  readonly prompt: string;
  readonly result: Readonly<Record<string, string>>;
  readonly project?: string;
  readonly skill?: string;
  readonly runId?: string;
  readonly pendingBossQuestion?: PendingBossQuestion;
  readonly bossReply?: string;
}

/** Delegated-player actor contract. */
export interface PlayerInput {
  readonly stateId: string;
  readonly role: string;
  readonly sourceItem: string;
  readonly prompt: string;
  readonly result: Readonly<Record<string, string>>;
  readonly project?: string;
  readonly requirementsFile?: string;
  readonly skill?: string;
  readonly runId?: string;
  readonly scenarioFindings?: string;
  readonly reviewFindings?: string;
  readonly pendingBossQuestion?: PendingBossQuestion;
  readonly bossReply?: string;
}

export type CaptainOutput =
  | { readonly guard: 'passed' }
  | { readonly guard: 'failed' }
  | { readonly guard: 'accepted'; readonly response: string }
  | {
      readonly guard: 'incomplete';
      readonly response: string;
      readonly failureDetails: string;
      readonly runId: string;
    }
  | { readonly guard: 'needsBossReply'; readonly question: string };

export type PlayerOutput =
  | { readonly guard: 'ready' }
  | { readonly guard: 'requirementsGap' }
  | { readonly guard: 'environmentBlocked' }
  | { readonly guard: 'done' }
  | { readonly guard: 'passed' }
  | { readonly guard: 'gaps'; readonly scenarioFindings: string }
  | { readonly guard: 'recorded'; readonly runId: string }
  | { readonly guard: 'sufficient' }
  | { readonly guard: 'repairable'; readonly reviewFindings: string }
  | { readonly guard: 'productFailed'; readonly reviewFindings: string }
  | { readonly guard: 'needsBossReply'; readonly question: string };

/**
 * Terminal machine output. `response` is required in every terminal outcome;
 * `runId` is required only by the incomplete outcome, and is omitted when the
 * terminal run did not establish one (an absent-requirements or
 * environment-blocked settlement precedes any run).
 */
export type DeliveryAcceptanceMachineOutput =
  | { readonly status: 'accepted'; readonly response: string }
  | {
      readonly status: 'incomplete';
      readonly response: string;
      readonly failureDetails: string;
      readonly runId?: string;
    };

export interface MachineContext {
  project: string;
  requirementsFile: string;
  skill: string;
  bossIntent?: string;
  runId?: string;
  scenarioFindings?: string;
  reviewFindings?: string;
  scenarioReviewRounds: number;
  executionReviewRounds: number;
  pendingBossQuestion?: PendingBossQuestion;
  bossReply?: string;
  outcome?: 'accepted' | 'incomplete';
  response: string;
  failureDetails: string;
  lastError?: NormalizedError;
}

export type MachineEvent =
  | { readonly type: 'BOSS_TASK'; readonly bossIntent?: string }
  | {
      readonly type: 'BOSS_INTERRUPT';
      readonly targetId: string;
      readonly bossIntent?: string;
    }
  | { readonly type: 'BOSS_REPLY'; readonly answer: string; readonly questionId?: string };

