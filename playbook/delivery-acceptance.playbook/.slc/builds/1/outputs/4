  'completion1',
]);
// Root final states whose terminal outcome leaves the procedure unfinished.
// `done` declares terminal `success`; `incomplete` declares terminal `failure`.
const UNFINISHED_FINAL_STATE_IDS: ReadonlySet<string> = new Set([
  'incomplete',
]);
// Fields annotated exactly `<verbatim final text>` across the FSM result maps.
// `question` is not one of them: its annotation is
// `<verbatim question text from the acting agent's prose>`, which declares
// presentation authority without carrying the player's final text.
const VERBATIM_PAYLOAD_FIELDS: ReadonlySet<string> = new Set([
  'scenarioFindings',
  'reviewFindings',
]);

export function validateOptions(value: unknown): PlaybookRuntimeOptions {
  const captured = snapshotJsonValue(value === undefined ? {} : value, 'DELIVERY ACCEPTANCE runtime options');
  if (captured === null || typeof captured !== 'object' || Array.isArray(captured)) {
    throw new TypeError('DELIVERY ACCEPTANCE runtime options must be an object');
  }
  const fields = captured as Readonly<Record<string, unknown>>;
  for (const key of Object.keys(captured)) {
    if (!Object.hasOwn(OPTION_SCHEMA, key)) throw new TypeError('DELIVERY ACCEPTANCE runtime options.' + key + ' is not declared');
  }
  for (const [key, schema] of Object.entries(OPTION_SCHEMA) as [string, { type: string; required: boolean }][]) {
    if (!Object.hasOwn(captured, key)) {
      if (schema.required) throw new TypeError('DELIVERY ACCEPTANCE runtime options.' + key + ' is required');
    } else if (typeof fields[key] !== schema.type) {
      throw new TypeError('DELIVERY ACCEPTANCE runtime options.' + key + ' must be a ' + schema.type);
    }
  }
  return captured as unknown as PlaybookRuntimeOptions;
}

// slc/link.md §Player prompt composition: exactly one callback-based pass over
// the original template, so an inserted value can never reenter substitution
// and JavaScript replacement tokens such as `$&`, `$$`, and `$'` stay literal.
// A standalone `> <placeholder>` relay line whose value is empty is omitted
// entirely rather than left as an empty quoted line; a multi-line value keeps
// its `> ` marker on every continuation line; a missing or non-string value
// leaves the token in place.
function renderQuotedRelays(
  prompt: string,
  fields: Readonly<Record<string, unknown>>,
  mapping: Readonly<Record<string, string>>,
): string {
  return prompt.replace(
    /^> <(#|[A-Za-z_$][A-Za-z0-9_$-]*)>(\r?\n|$)|<(#|[A-Za-z_$][A-Za-z0-9_$-]*)>/gm,
    (
      match: string,
      quoted: string | undefined,
      ending: string | undefined,
      inline: string | undefined,
    ): string => {
      const token = quoted ?? inline!;
      const field =
        mapping[token] ??
        (token === '#'
          ? 'irNumber'
          : token.replace(/-([A-Za-z0-9])/g, (_match: string, next: string) => next.toUpperCase()));
      const value = fields[field];
      if (typeof value !== 'string') return match;
      if (quoted === undefined) return value;
      if (value === '') return '';
      return (
        value
          .split(/(\r?\n)/)
          .map((part, index) => (index % 2 === 0 && part !== '' ? '> ' + part : part))
          .join('') + (ending ?? '')
      );
    },
  );
}

// The prompt identity lookup is unused here because no relay token in this FSM
// names a player identity; the argument stays in place for the seam's exact
// signature. The shared composer supplies only the continuation prefix, and
// the rendered body is appended once and never reenters substitution.
function composePlayerPrompt(input: PlaybookPlayerInput, _identity?: unknown, resuming = false): string {
  const fields = input as unknown as Readonly<Record<string, unknown>>;
  const body = renderQuotedRelays(input.prompt, fields, PLACEHOLDER_FIELDS);
  return defaultComposePlayerPrompt({ ...input, prompt: '' }, PLACEHOLDER_FIELDS, resuming) + body;
}

// slc/link.md §Captain prompt composition: the same relay integrity rules, the
// same continuation preamble (a direct Captain task always resumes from its own
// Boss question as a fresh visible call), and no player binding or resume
// instruction.
function composeCaptainPrompt(input: PlaybookCaptainInput): string {
  const fields = input as unknown as Readonly<Record<string, unknown>>;
  const body = renderQuotedRelays(input.prompt, fields, PLACEHOLDER_FIELDS);
  return composePlayerContinuation(input, body);
}

