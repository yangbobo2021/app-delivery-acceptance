// Every FSM construction input field is a genuine host-owned bootstrap value
// (the target project, its confirmed requirements file, and the installed
// skill path). `PlaybookSession` supplies none of them, so all three stay
// required readonly runtime options passed through to machine input. The entry
// event's own text is not one of them: `seedBossIntent` copies it from the
// event at the transition, and no FSM guard reads it before that first turn.
export interface PlaybookRuntimeOptions {
  readonly project: string;
  readonly requirementsFile: string;
  readonly skill: string;
}
export type PlaybookHostCapabilities = XStatePlaybookRuntimeConstruction<
  PlaybookRuntimeOptions, { readonly authority: object }
>['hostCapabilities'];

const OPTION_SCHEMA = {
  project: { type: 'string', required: true },
  requirementsFile: { type: 'string', required: true },
  skill: { type: 'string', required: true },
} as const;
const INPUT_MAPPING = {
  project: 'project',
  requirementsFile: 'requirementsFile',
  skill: 'skill',
} as const;
// No authored token/field exception exists: every relay token in this FSM
// resolves through the canonical kebab-token → camel-field mapping
// (`requirements-file`, `run-id`, `scenario-findings`, `review-findings`).
const PLACEHOLDER_FIELDS: Readonly<Record<string, string>> = {};
// Targets of `awaitBossReply.on.BOSS_REPLY`, exactly as the FSM declares them
// (`RESUMABLE_STATE_IDS`); the `failed` arm of that transition is the
// malformed-reply sink, not a resumable state, so it is not a member here.
const RESUMABLE_STATE_IDS: ReadonlySet<string> = new Set([
  'entry1',
  'resource1',
  'scenario1',
  'scenario2',
  'scenario3',
  'scenario4',
  'scenario5',
  'execution1',
  'execution2',
  'execution3',
