  outcomeAuthority: { governedPlayerStates: {
    entry: { ready: unchanged(), requirementsGap: unchanged({ failureDetails: 'semantic' }), needsBossReply: question() },
    scenarioDesign: { done: unchanged(), needsBossReply: question() },
    scenarioReview: { passed: unchanged(), gaps: unchanged({ failureDetails: 'semantic' }), needsBossReply: question() },
