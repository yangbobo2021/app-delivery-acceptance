  roleStates: {
    entry: { role: 'analyst', label: 'Analyst validates and initializes the confirmed requirements file.' },
    scenarioDesign: { role: 'analyst', label: 'Analyst maps every confirmed requirement to black-box scenarios and methods.' },
    scenarioReview: { role: 'reviewer', label: 'Reviewer independently checks requirement coverage and scenario meaning.' },
    scenarioRepair: { role: 'analyst', label: 'Analyst repairs the named scenario gaps or the black-box stage failure.' },
