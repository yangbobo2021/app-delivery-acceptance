}
export type PlaybookHostCapabilities = XStatePlaybookRuntimeConstruction<
  PlaybookRuntimeOptions, { readonly authority: object }
>['hostCapabilities'];

const OPTION_SCHEMA = { cwd: { type: 'string', required: false } } as const;
const PLACEHOLDER_FIELDS: Readonly<Record<string, string>> = {};
const RESUMABLE_STATE_IDS: ReadonlySet<string> = new Set([
  'entry', 'scenarioDesign', 'scenarioReview', 'scenarioRepair', 'completion',
]);
const UNFINISHED_FINAL_STATE_IDS: ReadonlySet<string> = new Set(['incomplete']);
const VERBATIM_PAYLOAD_FIELDS: ReadonlySet<string> = new Set([]);

export function validateOptions(value: unknown): PlaybookRuntimeOptions {
  const captured = snapshotJsonValue(value === undefined ? {} : value, 'BLACK BOX SCENARIOS runtime options');
  if (captured === null || typeof captured !== 'object' || Array.isArray(captured)) {
    throw new TypeError('BLACK BOX SCENARIOS runtime options must be an object');
  }
  const fields = captured as Readonly<Record<string, unknown>>;
  for (const key of Object.keys(captured)) {
    if (!Object.hasOwn(OPTION_SCHEMA, key)) throw new TypeError('BLACK BOX SCENARIOS runtime options.' + key + ' is not declared');
  }
  for (const [key, schema] of Object.entries(OPTION_SCHEMA) as [string, { type: string; required: boolean }][]) {
    if (!Object.hasOwn(captured, key)) {
      if (schema.required) throw new TypeError('BLACK BOX SCENARIOS runtime options.' + key + ' is required');
    } else if (typeof fields[key] !== schema.type || (schema.type === 'number' && !Number.isFinite(fields[key]))) {
      throw new TypeError('BLACK BOX SCENARIOS runtime options.' + key + ' must be a ' + schema.type);
    }
  }
  return captured as unknown as PlaybookRuntimeOptions;
}

// One callback-based pass over the original template. A standalone relay line
// `> <token>` renders the FSM input's own value: an empty value omits the
// complete line, a multi-line value is quoted line by line, and inserted text
// is literal — it is never substituted again and `$` replacement tokens are
// not interpreted. Inline `<token>` occurrences substitute in place.
function renderSourcePrompt(prompt: string, fields: Readonly<Record<string, unknown>>): string {
  const mapping = PLACEHOLDER_FIELDS;
  return prompt.replace(
    /^> <(#|[A-Za-z_$][A-Za-z0-9_$-]*)>(\r?\n|$)|<(#|[A-Za-z_$][A-Za-z0-9_$-]*)>/gm,
    (match: string, quoted: string | undefined, ending: string | undefined, inline: string | undefined): string => {
      const token = quoted ?? inline!;
      const field = mapping[token] ?? (token === '#' ? 'irNumber' : token.replace(/-([A-Za-z0-9_$])/g, (_match: string, next: string) => next.toUpperCase()));
      const value = fields[field];
      if (typeof value !== 'string') return match;
      if (quoted === undefined) return value;
      if (value === '') return '';
      return value.split(/(\r?\n)/).map((part, index) => index % 2 === 0 && part !== '' ? '> ' + part : part).join('') + (ending ?? '');
    },
  );
}

function composePlayerPrompt(input: PlaybookPlayerInput, _identity?: unknown, resuming = false): string {
  const body = renderSourcePrompt(input.prompt, input as unknown as Readonly<Record<string, unknown>>);
  return composePlayerContinuation(input, body, resuming);
}

function composeCaptainPrompt(input: PlaybookCaptainInput): string {
  const body = renderSourcePrompt(input.prompt, input as unknown as Readonly<Record<string, unknown>>);
  return composePlayerContinuation(input, body);
}

