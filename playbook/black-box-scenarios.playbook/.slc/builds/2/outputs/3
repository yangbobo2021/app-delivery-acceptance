    incomplete: {
      id: 'incomplete', type: 'final', description: 'Black-box scenario design did not complete: the black-box stage gate failed after the allowed repairs, material gaps remained after three rounds, or the requirements were unavailable.',
      meta: { playbook: { stateId: 'incomplete', description: 'Black-box scenario design did not complete: the black-box stage gate failed after the allowed repairs, material gaps remained after three rounds, or the requirements were unavailable.', terminal: 'failure' } },
    },
  },
});
